{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    },
     {
      "label": "common-python_v",
      "type": "shell",
      "command": "python -V",
      "dependsOn": [
        "common-down_pwd_xml"
      ],
      "options": {
        "cwd": "${workspaceRoot}"
      }
    },
    {
      "label": "common-down_pwd_xml",
      "type": "shell",
      "command": "python -V",
      "options": {
        "cwd": "${workspaceRoot}"
      }
    }
  ]
}
